{
  "name": "amayra",
  "productName": "AMAYRA",
  "description": "AMAYRA \u00e2\u20ac\u201d a private 3D AI desktop companion powered by each user's own Gemini API key.",
  "author": "AMAYRA",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:server": "esbuild server.ts --bundle --platform=node --format=cjs --sourcemap --packages=external --outfile=dist/server.cjs --watch --sourcemap=linked",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --sourcemap --packages=external --outfile=dist/server.cjs",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build:server && electron .",
    "start": "npm run build:server && electron .",
    "dist": "npm run build:server && npm run build:renderer && electron-builder --win nsis",
    "dist:repack": "npm run build:server && electron-builder --win nsis",
    "dist:dir": "npm run build:server && electron-builder --win nsis --dir"
  },
  "dependencies": {
    "@google/genai": "2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mmd-parser": "^1.0.4",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "electron": "43.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.amayra.desktop",
    "productName": "AMAYRA",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "agent_dist/amayra-agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/AMAYRA-launcher.exe",
        "to": ".",
        "filter": [
          "AMAYRA-launcher.exe"
        ]
      }
    ],
    "afterPack": "electron/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AMAYRA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AMAYRA-Setup-${version}.${ext}",
      "uninstallDisplayName": "Uninstall AMAYRA"
    }
  }
}