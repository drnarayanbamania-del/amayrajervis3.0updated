# AMAYRA backend configuration (development only).
# The packaged app asks the user for their own Gemini API key on first run and
# stores it in the per-user data directory — never in this repository.

# Optional in development: a fallback key used only when the user has not
# saved one through the app yet.
GEMINI_API_KEY=

# Desktop agent endpoints (defaults shown)
DESKTOP_AGENT_URL=http://127.0.0.1:8765
DESKTOP_OBSERVER_URL=http://127.0.0.1:8766

# Cognition feature flags (defaults shown in cognition/config.ts)
# AMAYRA_ENABLE_COGNITION=1
# AMAYRA_ENABLE_INITIATIVE=1
# AMAYRA_ENABLE_PROACTIVE_SPEECH=1
# AMAYRA_ENABLE_SCREEN_AWARENESS=0

# Writable data directory override (packaged app sets this automatically)
# AMAYRA_DATA_DIR=
